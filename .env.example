# Copy to .env for local testing, or set these as environment variables in Coolify.

# Required in Coolify: a long random string used to sign session cookies and encrypt
# the stored Qwen API key. If unset, the app generates and persists one under
# DATA_DIR/.app_secret on first boot — fine for a single instance, but set this
# explicitly if you ever run more than one replica or want a stable secret.
APP_SECRET=

# Where the app stores its SQLite DB, thumbnails, and dataset outputs. Point this at
# a persistent volume in Coolify.
DATA_DIR=/data

PORT=8000

# You can also set the public base URL here instead of through the setup wizard /
# Settings page (Settings always takes precedence once set there).
# PUBLIC_BASE_URL=https://video.yourdomain.com
